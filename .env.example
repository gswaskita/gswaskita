# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# KEYSTATIC CMS CONFIGURATION:
# In development, Keystatic runs in local mode (saving directly to src/content/).
# In production on Vercel/GitHub, you can optionally enable GitHub mode:
# PUBLIC_KEYSTATIC_GITHUB_REPO="username/repository"
# KEYSTATIC_SECRET="a-random-secret"
# KEYSTATIC_GITHUB_CLIENT_ID=""
# KEYSTATIC_GITHUB_CLIENT_SECRET=""

# APP_URL: The URL where this applet or website is hosted.
APP_URL="MY_APP_URL"

---
import Layout from '../../layouts/Layout.astro';
import { BlogPage } from '../../components/pages/BlogPage';
import { getPortfolioData } from '../../lib/keystatic';

const data = await getPortfolioData();
---

<Layout 
  title={`Academic Blog & Working Essays - ${data.profile.name}`}
  description="Qualitative research essays, working notes, methodological reflections, and operations management essays."
  currentPage="blog"
  data={data}
>
  <BlogPage
    client:load
    posts={data.blogPosts || []}
    profile={data.profile}
    phdStatus={data.phdStatus}
    pageContent={data.pageContent}
    currentUser={null}
    onOpenLogin={() => {}}
    comments={data.comments || []}
    onAddComment={() => {}}
    onLikeComment={() => {}}
    onNavigate={(page) => {
      if (typeof window !== 'undefined') {
        window.location.href = page === 'home' ? '/' : '/' + page;
      }
    }}
  />
</Layout>
